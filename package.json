{
  "name": "mon-petit-potager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mobile:sync": "npm run build && cap sync",
    "android:debug": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "android:open": "npm run mobile:sync && cap open android",
    "ios:open": "npm run mobile:sync && cap open ios",
    "android:publish": "npm run android:debug && node scripts/publish-apk.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/query-sync-storage-persister": "5.104.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-persist-client": "5.104.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
